{
    "name": "transistorized-cmd/deploy-kit",
    "description": "Deployer recipes for zero-downtime Laravel deployments.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4.27",
        "deployer/deployer": "^8.0.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "DeployKit\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "DeployKit\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
