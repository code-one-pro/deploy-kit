# /etc/cron.d/<short-name>-scheduler  (mode 644, owner root).
# cron ignores any file in /etc/cron.d whose name contains a dot, so <short-name> uses only
# letters, digits and hyphens: "openbrain", never "openbrain.pellicer.org".
# Replace <app-user> and <base-path>. Install dk-scheduler-run first (see docs/cutover-runbook.md).
# Pause: sudo -u <app-user> touch <base-path>/shared/storage/scheduler.paused  (rm the file to resume).
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
* * * * * <app-user> /usr/local/bin/dk-scheduler-run <base-path> >> <base-path>/shared/storage/logs/scheduler.log 2>&1
